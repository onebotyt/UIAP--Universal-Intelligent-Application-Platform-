{
  "compilerOptions": {
    "target": "ES2024",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2024"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true
  },
  "references": [
    { "path": "./packages/module-sdk" },
    { "path": "packages/core" },
    { "path": "./apps/edge-api" },
    { "path": "./modules/platform-proof-demo" }
  ],
  "files": [],
  "exclude": ["node_modules"]
}
