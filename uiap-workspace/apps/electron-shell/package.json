{
  "name": "electron-shell",
  "version": "1.0.0",
  "description": "UIAP Edge Desktop Application",
  "author": "UIAP Team",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc && electron .",
    "build": "tsc",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.uiap.edge",
    "productName": "UIAP Edge Server",
    "files": [
      "dist/**/*",
      "../edge-api/dist/**/*",
      "../edge-web/dist/**/*",
      "../../packages/core/dist/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "npmRebuild": false, "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "electron": "33.0.0",
    "electron-builder": "25.1.8",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "app-builder-bin": "5.0.0-alpha.10"
  }
}
