# ── UIAP Edge — Environment Variables ────────────────────────────
# Copy this file to .env and fill in the values for your local installation.
# NEVER commit a populated .env file.

# Node environment
NODE_ENV=development

# Edge API server
PORT=3000

# PostgreSQL — local organization database
DATABASE_URL=postgres://uiap_user:CHANGE_ME@localhost:5432/uiap_dev

# JWT authentication (generate a strong random string for production)
JWT_SECRET=CHANGE_ME_BEFORE_PRODUCTION
JWT_EXPIRES_IN=8h

# Logging
LOG_LEVEL=debug
