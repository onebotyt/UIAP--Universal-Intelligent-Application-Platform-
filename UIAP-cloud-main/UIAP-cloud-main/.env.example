# Copy this file to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Database ---
# Local Postgres connection string
DATABASE_URL=postgres://postgres:uiap123@localhost:5432/uiap_cloud

# --- Auth ---
# Long random string used to sign dashboard login JWTs.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# JWT expiry for dashboard sessions
JWT_EXPIRES_IN=8h

# --- Initial admin seed (used by `npm run seed`) ---
SEED_ADMIN_EMAIL=admin@uiap.local
SEED_ADMIN_PASSWORD=change_me_before_seeding
